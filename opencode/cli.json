{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "leader": "ctrl+space",
    "command.palette.show": "ctrl+s",
    "theme.switch": "none",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.first": "none",
    "session.last": "ctrl+g",
    "input.newline": "none"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
